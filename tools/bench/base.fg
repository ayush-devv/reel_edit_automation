[0:v]split=6[s0][s1][s2][s3][s4][s5];
[0:a]asplit=6[t0][t1][t2][t3][t4][t5];
[s0]trim=2:12,setpts=PTS-STARTPTS,crop=608:1080:656:0,scale=1080:1920:flags=lanczos,lut3d=file=warm.cube[v0];
[s1]trim=15:25,setpts=PTS-STARTPTS,crop=608:1080:656:0,scale=1080:1920:flags=lanczos,scale=w='trunc(1080*(1+0.15*min(t/0.4\,1))/2)*2':h='trunc(1920*(1+0.15*min(t/0.4\,1))/2)*2':eval=frame:flags=bicubic,crop=1080:1920:(iw-1080)/2:(ih-1920)/2,lut3d=file=warm.cube[v1];
[s2]trim=30:42,setpts=(PTS-STARTPTS)/1.5,crop=608:1080:656:0,scale=1080:1920:flags=lanczos,lut3d=file=warm.cube[v2];
[s3]trim=44:56,setpts=PTS-STARTPTS,crop=608:1080:600:0,scale=1080:1920:flags=lanczos,scale=w='trunc(1080*(1+0.12*min(t/0.3\,1))/2)*2':h='trunc(1920*(1+0.12*min(t/0.3\,1))/2)*2':eval=frame:flags=bicubic,crop=1080:1920:(iw-1080)/2:(ih-1920)/2,lut3d=file=warm.cube[v3];
[s4]trim=58:68,setpts=PTS-STARTPTS,crop=608:1080:700:0,scale=1080:1920:flags=lanczos,lut3d=file=warm.cube[v4];
[s5]trim=72:82,setpts=PTS-STARTPTS,crop=608:1080:656:0,scale=1080:1920:flags=lanczos,scale=w='trunc(1080*(1+0.10*min(t/0.4\,1))/2)*2':h='trunc(1920*(1+0.10*min(t/0.4\,1))/2)*2':eval=frame:flags=bicubic,crop=1080:1920:(iw-1080)/2:(ih-1920)/2,lut3d=file=warm.cube[v5];
[t0]atrim=2:12,asetpts=PTS-STARTPTS,afade=t=in:d=0.03,afade=t=out:st=9.97:d=0.03[a0];
[t1]atrim=15:25,asetpts=PTS-STARTPTS,afade=t=in:d=0.03,afade=t=out:st=9.97:d=0.03[a1];
[t2]atrim=30:42,asetpts=PTS-STARTPTS,atempo=1.5,afade=t=in:d=0.03,afade=t=out:st=7.97:d=0.03[a2];
[t3]atrim=44:56,asetpts=PTS-STARTPTS,afade=t=in:d=0.03,afade=t=out:st=11.97:d=0.03[a3];
[t4]atrim=58:68,asetpts=PTS-STARTPTS,afade=t=in:d=0.03,afade=t=out:st=9.97:d=0.03[a4];
[t5]atrim=72:82,asetpts=PTS-STARTPTS,afade=t=in:d=0.03,afade=t=out:st=9.97:d=0.03[a5];
[v0][a0][v1][a1][v2][a2][v3][a3][v4][a4][v5][a5]concat=n=6:v=1:a=1[vout][voice];
[voice]asplit=2[vo][sc];
[1:a]atrim=0:60,asetpts=PTS-STARTPTS,volume=-6dB[mus];
[mus][sc]sidechaincompress=threshold=0.05:ratio=8:attack=80:release=300[duck];
[vo][duck]amix=inputs=2:normalize=0,loudnorm=I=-14:TP=-1:LRA=11,aresample=48000[aout]
